{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git remote add *)",
      "PowerShell(git push *)",
      "PowerShell(git remote add *)",
      "CronCreate",
      "CronDelete",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task",
      "mcp__scheduled-tasks__delete_scheduled_task",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/Show-StartupContext.ps1",
              "-Claude"
            ],
            "timeout": 30,
            "statusMessage": "Loading project rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/Show-PersonaCard.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__computer-use__.*|CronCreate|CronDelete|mcp__scheduled-tasks__(create|update|delete)_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/Shaka-Gate.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
